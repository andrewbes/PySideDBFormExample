/* Сучасна світла тема для демонстраційної форми */

QMainWindow, QWidget#central {
    background: #EEF1F6;
    color: #1F2937;
    font-size: 14px;
}

QFrame#headerBar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
}

QLabel#appTitle {
    color: #111827;
    font-size: 20px;
    font-weight: 700;
}

QLabel#appSubtitle {
    color: #6B7280;
    font-size: 12px;
}

QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}

QLabel#cardTitle {
    color: #6B7280;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

QLabel#fieldLabel {
    color: #6B7280;
    font-size: 12px;
    font-weight: 600;
}

QLineEdit, QDateEdit, QComboBox {
    background: #F8FAFC;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 22px;
    selection-background-color: #C7D2FE;
    selection-color: #111827;
}

QLineEdit:focus, QDateEdit:focus, QComboBox:focus {
    background: #FFFFFF;
    border: 1px solid #4F46E5;
}

QDateEdit::drop-down, QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #111827;
    border: 1px solid #E5E7EB;
    selection-background-color: #EEF2FF;
    selection-color: #111827;
    outline: none;
}

QFrame#totalCard {
    background: #EEF2FF;
    border: 1px solid #C7D2FE;
    border-radius: 14px;
}

QLabel#totalCaption {
    color: #4338CA;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#totalValue {
    color: #312E81;
    font-size: 26px;
    font-weight: 700;
}

QTableView {
    background: #FFFFFF;
    color: #111827;
    alternate-background-color: #F8FAFC;
    border: none;
    gridline-color: #F3F4F6;
    selection-background-color: #EEF2FF;
    selection-color: #111827;
    outline: none;
}

QTableView::item {
    color: #111827;
    background: #FFFFFF;
    padding: 6px 10px;
}

QTableView::item:alternate {
    color: #111827;
    background: #F8FAFC;
}

QHeaderView::section {
    background: #F9FAFB;
    color: #6B7280;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 10px 12px;
    font-weight: 700;
    font-size: 12px;
}

QTableView::item:selected {
    color: #111827;
    background: #EEF2FF;
}

QPushButton {
    background: #FFFFFF;
    color: #374151;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background: #F9FAFB;
    border-color: #D1D5DB;
}

QPushButton:pressed {
    background: #F3F4F6;
}

QPushButton:disabled {
    color: #9CA3AF;
    background: #F3F4F6;
}

QPushButton#primaryButton {
    background: #4F46E5;
    color: #FFFFFF;
    border: 1px solid #4F46E5;
}

QPushButton#primaryButton:hover {
    background: #4338CA;
}

QPushButton#dangerButton {
    background: #FEF2F2;
    color: #B91C1C;
    border: 1px solid #FECACA;
}

QPushButton#dangerButton:hover {
    background: #FEE2E2;
}

QPushButton#ghostButton {
    background: transparent;
    border: 1px solid #E5E7EB;
}

QFrame#footerBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

QLabel#positionLabel {
    color: #4B5563;
    font-weight: 600;
}

QStatusBar {
    background: #FFFFFF;
    color: #6B7280;
    border-top: 1px solid #E5E7EB;
}

QToolTip {
    background: #111827;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}
